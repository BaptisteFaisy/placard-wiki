# Dépendances et builds
node_modules/
dist/
build/
.forge/
*.tsbuildinfo

# Couverture de tests
coverage/

# Environnement et secrets — jamais de valeur dans le dépôt
.env
.env.*
!.env.example

# Éditeurs et OS
.DS_Store
*.swp
.idea/
.vscode/

# Journaux
*.log
npm-debug.log*
pnpm-debug.log*

# Bytecode Python : les gardes et les agents Hermes sont en stdlib, leurs .pyc
# ne se versionnent jamais (leçon d'un dépôt voisin : un .pyc suivi a valu une
# PR de nettoyage).
__pycache__/
*.py[cod]
.pytest_cache/

