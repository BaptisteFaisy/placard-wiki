# Seed de l'espace de démonstration Placard (§15).
# Aucune valeur réelle ici — remplissez localement, ne commitez JAMAIS ce fichier.
# Copiez vers `.env` et sourcez-le, ou exportez les variables avant `pnpm seed:demo`.

# URL de base du site Confluence (sans le préfixe /wiki).
CONFLUENCE_BASE_URL=

# Identifiants : e-mail du compte + jeton API (jamais le mot de passe).
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Optionnel — préfixe REST.
#   Confluence Cloud : /wiki/rest/api (défaut)
#   Server / Data Center : /rest/api
CONFLUENCE_API_PREFIX=